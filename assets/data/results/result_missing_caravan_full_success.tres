value = 6

[resource]
script = ExtResource("1_result_asset")
id = &"result_missing_caravan_full_success"
conditions = Array[ExtResource("3_condition_resource")]([SubResource("AbilityCondition_investigation_7"), SubResource("AbilityCondition_battle_6")])
report_text = "【占位占位】"
