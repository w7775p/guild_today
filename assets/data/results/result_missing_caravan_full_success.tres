; 正式内容资产：完整成功。阈值来自 V3 Task 2 工作规则，报告与效果仍为占位。
[gd_resource type="Resource" script_class="ResultAsset" load_steps=6 format=3]

[ext_resource type="Script" path="res://assets/types/result_asset.gd" id="1_result_asset"]
[ext_resource type="Script" path="res://assets/types/ability_condition.gd" id="2_ability_condition"]
[ext_resource type="Script" path="res://assets/types/condition_resource.gd" id="3_condition_resource"]

[sub_resource type="Resource" id="AbilityCondition_investigation_7"]
script = ExtResource("2_ability_condition")
