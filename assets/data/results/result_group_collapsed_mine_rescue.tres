; 正式内容资产：塌方矿井结果组。八个条件按三项能力阈值划分为互斥分区。
[gd_resource type="Resource" script_class="ResultGroupAsset" load_steps=10 format=3]

[ext_resource type="Script" path="res://assets/types/result_group_asset.gd" id="1_result_group"]
[ext_resource type="Script" path="res://assets/types/result_asset.gd" id="2_result_asset"]
[ext_resource type="Resource" path="res://assets/data/results/result_collapsed_mine_ventilation_rescue.tres" id="3_ventilation_rescue"]
[ext_resource type="Resource" path="res://assets/data/results/result_collapsed_mine_side_shaft_rescue.tres" id="4_side_shaft_rescue"]
[ext_resource type="Resource" path="res://assets/data/results/result_collapsed_mine_forced_entry.tres" id="5_forced_entry"]
[ext_resource type="Resource" path="res://assets/data/results/result_collapsed_mine_safe_nest_clearance.tres" id="6_safe_nest_clearance"]
[ext_resource type="Resource" path="res://assets/data/results/result_collapsed_mine_side_shaft_mapping.tres" id="7_side_shaft_mapping"]
[ext_resource type="Resource" path="res://assets/data/results/result_collapsed_mine_coordinated_entry.tres" id="8_coordinated_entry"]
[ext_resource type="Resource" path="res://assets/data/results/result_collapsed_mine_failure.tres" id="9_failure"]
[ext_resource type="Resource" path="res://assets/data/results/result_collapsed_mine_total_rescue.tres" id="10_total_rescue"]

[resource]
script = ExtResource("1_result_group")
id = &"result_group_collapsed_mine_rescue"
results = Array[ExtResource("2_result_asset")]([ExtResource("3_ventilation_rescue"), ExtResource("4_side_shaft_rescue"), ExtResource("5_forced_entry"), ExtResource("6_safe_nest_clearance"), ExtResource("7_side_shaft_mapping"), ExtResource("8_coordinated_entry"), ExtResource("9_failure"), ExtResource("10_total_rescue")])
