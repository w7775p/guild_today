; 正式内容资产：带伤救回。受伤规则采用工作性推测，报告终态保留占位。
[gd_resource type="Resource" script_class="ResultAsset" load_steps=10 format=3]

[ext_resource type="Script" path="res://assets/types/result_asset.gd" id="1_result_asset"]
[ext_resource type="Script" path="res://assets/types/ability_condition.gd" id="2_ability_condition"]
[ext_resource type="Script" path="res://assets/types/ability_below_condition.gd" id="3_ability_below_condition"]
[ext_resource type="Script" path="res://assets/types/condition_resource.gd" id="4_condition_resource"]
[ext_resource type="Script" path="res://assets/types/effect_resource.gd" id="5_effect_resource"]
[ext_resource type="Script" path="res://assets/types/injury_effect.gd" id="6_injury_effect"]
[ext_resource type="Script" path="res://assets/types/task_outcome_effect.gd" id="7_task_outcome_effect"]

[sub_resource type="Resource" id="AbilityCondition_investigation_5"]
script = ExtResource("2_ability_condition")
ability_id = &"investigation"
value = 5

[sub_resource type="Resource" id="AbilityCondition_battle_4"]
script = ExtResource("2_ability_condition")
ability_id = &"battle"
value = 4

[sub_resource type="Resource" id="AbilityBelowCondition_battle_6"]
script = ExtResource("3_ability_below_condition")
ability_id = &"battle"
value = 6

[sub_resource type="Resource" id="InjuryEffect_injured_rescue"]
script = ExtResource("6_injury_effect")
target_rule = &"highest_battle_member"
severity = 1

[sub_resource type="Resource" id="TaskOutcomeEffect_injured_rescue"]
script = ExtResource("7_task_outcome_effect")
terminal_state_id = &"【task_outcome_injured_rescue】"

[resource]
script = ExtResource("1_result_asset")
id = &"result_missing_caravan_injured_rescue"
conditions = Array[ExtResource("4_condition_resource")]([SubResource("AbilityCondition_investigation_5"), SubResource("AbilityCondition_battle_4"), SubResource("AbilityBelowCondition_battle_6")])
effects = Array[ExtResource("5_effect_resource")]([SubResource("InjuryEffect_injured_rescue"), SubResource("TaskOutcomeEffect_injured_rescue")])
report_text = "【report_missing_caravan_injured_rescue】"
